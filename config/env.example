# Archivo de ejemplo para variables de entorno de AsuGusto
# Copia este archivo como .env y completa los valores reales

# URL del proyecto en Supabase
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave pública (anon key)
SUPABASE_ANON_KEY=TU_ANON_KEY

# Clave de servicio (service role) — NO usar en frontend
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Nombre del proyecto
APP_NAME=AsuGusto

# Entorno actual: development | production
APP_ENV=development

# Puerto del servidor local
PORT=3000

# Activar logs internos
ENABLE_LOGS=true
